{
    "targets": {
        "browsers": [
            "last 5 versions",
            "ie >= 8"
        ]
    },
    "presets": [
        "@babel/preset-env",
        "@babel/preset-react"
    ],
    "plugins": [
        [
            "polyfill-corejs3",
            {
                "method": "usage-global",
                "version": "3"
            }
        ]
    ]
}
